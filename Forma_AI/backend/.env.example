# Copy this file to .env and fill in your own values.

# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/forma-ai

# Port the Express server listens on
PORT=5000

# Optional — if set, /api/ai/extract uses the real OpenAI model.
# If left empty, Forma AI automatically falls back to the
# built-in rule-based extractor so the app still works offline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
